@model IEnumerable<GymLocationViewModel>
<h1>Manage Locations</h1><a class="btn" asp-action="Add">Add</a>
<table><tr><th>Name</th><th>City</th><th>Address</th><th></th></tr>@foreach (var item in Model){<tr><td>@item.Name</td><td>@item.City</td><td>@item.Address</td><td><a asp-action="Edit" asp-route-id="@item.Id">Edit</a><form asp-action="Delete" asp-route-id="@item.Id" method="post"><button>Delete</button></form></td></tr>}</table>
