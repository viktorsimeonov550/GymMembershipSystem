@model DashboardStatisticsViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<section class="section">
    <span class="badge">Administration</span>
    <h1 class="page-title">Admin Dashboard</h1>
    <p class="page-subtitle">Quick overview of memberships, trainers, workouts and bookings. The statistics block is also loaded through AJAX from the API controller.</p>
</section>

<div class="grid stats section" id="admin-stats">
    <div><strong>@Model.TotalPlans</strong><span>Plans</span></div>
    <div><strong>@Model.TotalTrainers</strong><span>Trainers</span></div>
    <div><strong>@Model.TotalWorkoutClasses</strong><span>Workouts</span></div>
    <div><strong>@Model.TotalBookings</strong><span>Bookings</span></div>
    <div><strong>@Model.ActiveMemberships</strong><span>Active memberships</span></div>
</div>

<div class="admin-links">
    <a class="btn btn-secondary" asp-area="Admin" asp-controller="MembershipPlans" asp-action="All">Manage Plans</a>
    <a class="btn btn-secondary" asp-area="Admin" asp-controller="Trainers" asp-action="All">Manage Trainers</a>
    <a class="btn btn-secondary" asp-area="Admin" asp-controller="WorkoutClasses" asp-action="All">Manage Workouts</a>
    <a class="btn btn-secondary" asp-area="Admin" asp-controller="GymLocations" asp-action="All">Manage Locations</a>
</div>

@section Scripts { <script src="~/js/statistics.js"></script> }
