@using GymMembershipSystem.Data.Common
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GymMembershipSystem</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="site-header">
    <nav class="navbar">
        <a asp-area="" asp-controller="Home" asp-action="Index" class="brand">
            <span class="brand-mark">G</span>
            <span>GymMembership</span>
        </a>
        <a asp-area="" asp-controller="MembershipPlans" asp-action="All">Plans</a>
        <a asp-area="" asp-controller="Trainers" asp-action="All">Trainers</a>
        <a asp-area="" asp-controller="WorkoutClasses" asp-action="All">Workouts</a>
        @if (User.Identity?.IsAuthenticated ?? false)
        {
            <a asp-area="" asp-controller="MyMembership" asp-action="Index">My Membership</a>
            <a asp-area="" asp-controller="Bookings" asp-action="Mine">My Bookings</a>
            @if (User.IsInRole(ApplicationConstants.AdministratorRoleName))
            {
                <a class="nav-cta" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin</a>
            }
            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="logout-form">
                <button type="submit">Logout</button>
            </form>
        }
        else
        {
            <a asp-area="" asp-controller="Account" asp-action="Login">Login</a>
            <a class="nav-cta" asp-area="" asp-controller="Account" asp-action="Register">Join now</a>
        }
    </nav>
</header>
<main class="container">
    <partial name="_TempDataMessage" />
    @RenderBody()
</main>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
