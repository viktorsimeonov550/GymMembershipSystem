@{
    ViewData["Title"] = "About";
}

<section class="section content-panel">
    <span class="badge">About the project</span>
    <h1 class="page-title">GymMembershipSystem</h1>
    <p class="page-subtitle">
        This is an ASP.NET Core MVC membership management project inspired by the structure of HouseRentingSystem.
        It uses Web, Data and Services projects, Entity Framework Core, Identity, seeded data, services, controllers and Razor views.
    </p>
    <div class="feature-list">
        <div class="feature-item"><strong>Members</strong><span>Subscribe to plans and book workout classes.</span></div>
        <div class="feature-item"><strong>Admins</strong><span>Manage plans, trainers, workouts and locations.</span></div>
        <div class="feature-item"><strong>Services</strong><span>Business rules stay outside the controllers.</span></div>
    </div>
</section>
