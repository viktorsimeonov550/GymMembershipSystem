@model GymMembershipSystem.Web.Models.Account.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<section class="auth-shell">
    <div class="auth-card">
        <span class="eyebrow">Member access</span>
        <h1>Login</h1>
        <p>Access your membership, bookings and premium gym benefits.</p>

        <form asp-controller="Account" asp-action="Login" method="post">
            <input asp-for="ReturnUrl" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <div class="form-group">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="form-control" autocomplete="username" />
                <span asp-validation-for="Email" class="field-validation"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password"></label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Password" class="field-validation"></span>
            </div>

            <label class="check-row">
                <input asp-for="RememberMe" />
                <span>Remember me</span>
            </label>

            <button type="submit" class="btn-primary full-width">Login</button>
        </form>

        <p class="auth-switch">No account yet? <a asp-controller="Account" asp-action="Register">Join now</a></p>
        <p class="auth-hint">Admin: admin@gym.local / Admin123</p>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
