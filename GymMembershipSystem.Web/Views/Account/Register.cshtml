@model GymMembershipSystem.Web.Models.Account.RegisterViewModel
@{
    ViewData["Title"] = "Join now";
}

<section class="auth-shell">
    <div class="auth-card wide">
        <span class="eyebrow">Start training smarter</span>
        <h1>Join GymMembership</h1>
        <p>Create an account and choose a membership plan with access to workouts, trainers and premium gym facilities.</p>

        <form asp-controller="Account" asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <div class="form-grid">
                <div class="form-group">
                    <label asp-for="FirstName"></label>
                    <input asp-for="FirstName" class="form-control" autocomplete="given-name" />
                    <span asp-validation-for="FirstName" class="field-validation"></span>
                </div>

                <div class="form-group">
                    <label asp-for="LastName"></label>
                    <input asp-for="LastName" class="form-control" autocomplete="family-name" />
                    <span asp-validation-for="LastName" class="field-validation"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Age"></label>
                <input asp-for="Age" class="form-control" />
                <span asp-validation-for="Age" class="field-validation"></span>
            </div>

            <div class="form-group">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="form-control" autocomplete="username" />
                <span asp-validation-for="Email" class="field-validation"></span>
            </div>

            <div class="form-grid">
                <div class="form-group">
                    <label asp-for="Password"></label>
                    <input asp-for="Password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="field-validation"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ConfirmPassword"></label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="field-validation"></span>
                </div>
            </div>

            <button type="submit" class="btn-primary full-width">Create membership account</button>
        </form>

        <p class="auth-switch">Already have an account? <a asp-controller="Account" asp-action="Login">Login</a></p>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
